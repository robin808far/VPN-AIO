new file mode 100644
index 0000000..ff5ec45
--- /dev/null
+++ b/experimental/v2rayapi/limiter_test.go
@@ -0,0 +1,125 @@
+package v2rayapi
+
+import (
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func writeLimiterPolicy(t *testing.T, path string, user sidecarUserLimit) {
+	t.Helper()
+	data, err := json.Marshal(sidecarDocument{Users: []sidecarUserLimit{user}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// Ensure a subsequent same-size policy edit is observable even on a filesystem
+	// whose timestamp resolution is coarser than the test's write interval.
+	future := time.Now().Add(2 * time.Second)
+	if err := os.Chtimes(path, future, future); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func limiterMetadata(user, ip string) adapter.InboundContext {
+	return adapter.InboundContext{
+		User:   user,
+		Source: M.ParseSocksaddr(net.JoinHostPort(ip, "12345")),
+	}
+}
+
+func TestLimiterStateRejectsNewIPAndConcurrentStreamAtCaps(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "limits.json")
+	writeLimiterPolicy(t, path, sidecarUserLimit{Email: "alice", IPLimit: 1, StreamLimit: 2})
+	state := newLimiterState(path)
+	firstRelease, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.1"), nil)
+	if !ok {
+		t.Fatal("first session was rejected")
+	}
+	secondRelease, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.1"), nil)
+	if !ok {
+		t.Fatal("second session from the same source IP was rejected")
+	}
+	if _, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.2"), nil); ok {
+		t.Fatal("new source IP exceeded the IP cap")
+	}
+	if _, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.1"), nil); ok {
+		t.Fatal("new session exceeded the stream cap")
+	}
+	firstRelease()
+	secondRelease()
+	if _, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.2"), nil); !ok {
+		t.Fatal("released sessions did not free the IP and stream slots")
+	}
+}
+
+func TestLimiterStateAcceptStrategyEvictsOldestIP(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "limits.json")
+	writeLimiterPolicy(t, path, sidecarUserLimit{Email: "alice", IPLimit: 1, Strategy: "accept"})
+	state := newLimiterState(path)
+	closed := 0
+	firstRelease, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.1"), func() { closed++ })
+	if !ok {
+		t.Fatal("first source IP was rejected")
+	}
+	secondRelease, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.2"), func() { closed++ })
+	if !ok {
+		t.Fatal("accept strategy rejected the new source IP")
+	}
+	if closed != 1 {
+		t.Fatalf("closed sessions = %d, want oldest source session closed once", closed)
+	}
+	firstRelease() // Eviction already removed this session; release must be idempotent.
+	secondRelease()
+	state.mu.Lock()
+	defer state.mu.Unlock()
+	if state.streams["alice"] != 0 || len(state.sessions["alice"]) != 0 {
+		t.Fatalf("session state leaked after release: streams=%d ips=%d", state.streams["alice"], len(state.sessions["alice"]))
+	}
+}
+
+func TestLimiterStateSharesAndHotUpdatesPerAccountRates(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "limits.json")
+	writeLimiterPolicy(t, path, sidecarUserLimit{Email: "alice", DownBps: 2048, UpBps: 1024})
+	state := newLimiterState(path)
+	firstRelease, _, firstUp, firstDown, ok := state.admit(limiterMetadata("alice", "192.0.2.1"), nil)
+	if !ok {
+		t.Fatal("first session was rejected")
+	}
+	secondRelease, _, secondUp, secondDown, ok := state.admit(limiterMetadata("alice", "192.0.2.2"), nil)
+	if !ok {
+		t.Fatal("second session was rejected")
+	}
+	if firstUp != secondUp || firstDown != secondDown {
+		t.Fatal("same-account sessions do not share rate buckets")
+	}
+	if got := firstUp.Limit(); got != 1024 {
+		t.Fatalf("upload rate = %v, want 1024 B/s", got)
+	}
+	if got := firstDown.Limit(); got != 2048 {
+		t.Fatalf("download rate = %v, want 2048 B/s", got)
+	}
+	writeLimiterPolicy(t, path, sidecarUserLimit{Email: "alice", DownBps: 4096, UpBps: 2048})
+	// The test writer sets a future timestamp, causing the next admission to reload.
+	thirdRelease, _, _, _, ok := state.admit(limiterMetadata("alice", "192.0.2.3"), nil)
+	if !ok {
+		t.Fatal("third session was rejected")
+	}
+	if got := firstUp.Limit(); got != 2048 {
+		t.Fatalf("existing upload bucket was not hot-updated: %v", got)
+	}
+	if got := firstDown.Limit(); got != 4096 {
+		t.Fatalf("existing download bucket was not hot-updated: %v", got)
+	}
+	firstRelease()
+	secondRelease()
+	thirdRelease()
+}
