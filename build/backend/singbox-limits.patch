diff --git a/experimental/v2rayapi/limiter.go b/experimental/v2rayapi/limiter.go
new file mode 100644
index 0000000..5d9167b
--- /dev/null
+++ b/experimental/v2rayapi/limiter.go
@@ -0,0 +1,399 @@
+package v2rayapi
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"golang.org/x/time/rate"
+)
+
+const vpnAIOLimiterMarker = "vpn-aio-limits"
+
+// speedLimit sidecar entries are shared with VPN-AIO's Xray core. sing-box
+// consumes the same file so account policy changes do not require a core
+// restart. streamLimit is deliberately named for what it measures: routed
+// streams/connections, not physical devices.
+type sidecarUserLimit struct {
+	Email       string `json:"email"`
+	DownBps     int64  `json:"downBps"`
+	UpBps       int64  `json:"upBps"`
+	IPLimit     int    `json:"ipLimit"`
+	StreamLimit int    `json:"streamLimit"`
+	Strategy    string `json:"strategy"`
+}
+
+type sidecarDocument struct {
+	Users []sidecarUserLimit `json:"users"`
+}
+
+type limiterPolicy struct {
+	downBps, upBps int64
+	ipLimit        int
+	streamLimit    int
+	strategy       string
+}
+
+type limiterRates struct {
+	uplink   *rate.Limiter
+	downlink *rate.Limiter
+}
+
+type activeSession struct {
+	started time.Time
+	close   func()
+}
+
+type limiterState struct {
+	path    string
+	marker  string
+	modTime time.Time
+	size    int64
+
+	mu       sync.Mutex
+	policies map[string]limiterPolicy
+	rates    map[string]limiterRates
+	sessions map[string]map[string]map[uint64]activeSession
+	streams  map[string]int
+	nextID   uint64
+}
+
+func newLimiterState(path string) *limiterState {
+	return &limiterState{
+		path:     path,
+		marker:   vpnAIOLimiterMarker,
+		policies: make(map[string]limiterPolicy),
+		rates:    make(map[string]limiterRates),
+		sessions: make(map[string]map[string]map[uint64]activeSession),
+		streams:  make(map[string]int),
+	}
+}
+
+func setRateLimit(limiter *rate.Limiter, bps int64) {
+	if limiter == nil {
+		return
+	}
+	if bps <= 0 {
+		limiter.SetLimit(rate.Inf)
+		limiter.SetBurst(64 * 1024)
+		return
+	}
+	burst := int(bps)
+	if burst < 1 {
+		burst = 1
+	}
+	if burst > 64*1024 {
+		burst = 64 * 1024
+	}
+	limiter.SetLimit(rate.Limit(bps))
+	limiter.SetBurst(burst)
+}
+
+func (s *limiterState) updateRatesLocked() {
+	for user, rates := range s.rates {
+		policy := s.policies[user]
+		setRateLimit(rates.uplink, policy.upBps)
+		setRateLimit(rates.downlink, policy.downBps)
+		if policy.upBps <= 0 && policy.downBps <= 0 && len(s.sessions[user]) == 0 {
+			delete(s.rates, user)
+		}
+	}
+}
+
+func (s *limiterState) reloadLocked() {
+	if s.path == "" {
+		s.policies = map[string]limiterPolicy{}
+		s.updateRatesLocked()
+		return
+	}
+	info, err := os.Stat(s.path)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			s.policies = map[string]limiterPolicy{}
+			s.modTime = time.Time{}
+			s.size = 0
+			s.updateRatesLocked()
+		}
+		return
+	}
+	if info.ModTime().Equal(s.modTime) && info.Size() == s.size {
+		return
+	}
+	data, err := os.ReadFile(s.path)
+	if err != nil {
+		return
+	}
+	var document sidecarDocument
+	if err := json.Unmarshal(data, &document); err != nil {
+		return
+	}
+	policies := make(map[string]limiterPolicy, len(document.Users))
+	for _, user := range document.Users {
+		if user.Email == "" {
+			continue
+		}
+		policies[user.Email] = limiterPolicy{
+			downBps:     user.DownBps,
+			upBps:       user.UpBps,
+			ipLimit:     user.IPLimit,
+			streamLimit: user.StreamLimit,
+			strategy:    user.Strategy,
+		}
+	}
+	s.policies = policies
+	s.modTime = info.ModTime()
+	s.size = info.Size()
+	s.updateRatesLocked()
+}
+
+func (s *limiterState) admit(metadata adapter.InboundContext, closeConn func()) (func(), limiterPolicy, *rate.Limiter, *rate.Limiter, bool) {
+	user := metadata.User
+	if user == "" {
+		return func() {}, limiterPolicy{}, nil, nil, true
+	}
+	source := ""
+	if metadata.Source.IsValid() {
+		source = metadata.Source.Addr.String()
+	}
+	s.mu.Lock()
+	s.reloadLocked()
+	policy := s.policies[user]
+	if policy.ipLimit > 0 && source == "" {
+		s.mu.Unlock()
+		return func() {}, policy, nil, nil, false
+	}
+	if policy.streamLimit > 0 && s.streams[user] >= policy.streamLimit {
+		s.mu.Unlock()
+		return func() {}, policy, nil, nil, false
+	}
+	var evicted []func()
+	if policy.ipLimit > 0 {
+		active := s.sessions[user]
+		if active[source] == nil && len(active) >= policy.ipLimit {
+			if policy.strategy != "accept" {
+				s.mu.Unlock()
+				return func() {}, policy, nil, nil, false
+			}
+			oldestIP := ""
+			var oldest time.Time
+			for ip, sessions := range active {
+				for _, session := range sessions {
+					if oldest.IsZero() || session.started.Before(oldest) {
+						oldestIP, oldest = ip, session.started
+					}
+				}
+			}
+			for id, session := range active[oldestIP] {
+				delete(active[oldestIP], id)
+				s.streams[user]--
+				if session.close != nil {
+					evicted = append(evicted, session.close)
+				}
+			}
+			delete(active, oldestIP)
+		}
+	}
+
+	s.nextID++
+	id := s.nextID
+	active := s.sessions[user]
+	if active == nil {
+		active = make(map[string]map[uint64]activeSession)
+		s.sessions[user] = active
+	}
+	byIP := active[source]
+	if byIP == nil {
+		byIP = make(map[uint64]activeSession)
+		active[source] = byIP
+	}
+	byIP[id] = activeSession{started: time.Now(), close: closeConn}
+	s.streams[user]++
+	rates := s.rates[user]
+	if rates.uplink == nil {
+		rates.uplink = newRate(policy.upBps)
+	}
+	if rates.downlink == nil {
+		rates.downlink = newRate(policy.downBps)
+	}
+	s.rates[user] = rates
+	uplink, downlink := rates.uplink, rates.downlink
+	s.mu.Unlock()
+	for _, closeOld := range evicted {
+		closeOld()
+	}
+
+	var once sync.Once
+	release := func() {
+		once.Do(func() {
+			s.mu.Lock()
+			if sessions := s.sessions[user]; sessions != nil {
+				if byIP := sessions[source]; byIP != nil {
+					if _, exists := byIP[id]; exists {
+						delete(byIP, id)
+						s.streams[user]--
+						if len(byIP) == 0 {
+							delete(sessions, source)
+						}
+					}
+					if len(sessions) == 0 {
+						delete(s.sessions, user)
+						delete(s.streams, user)
+						if current := s.policies[user]; current.upBps <= 0 && current.downBps <= 0 {
+							delete(s.rates, user)
+						}
+					}
+				}
+			}
+			s.mu.Unlock()
+		})
+	}
+	return release, policy, uplink, downlink, true
+}
+
+func limiterContextRelease(ctx context.Context, release func()) func() {
+	if release == nil {
+		return func() {}
+	}
+	stop := context.AfterFunc(ctx, release)
+	return func() {
+		if stop() {
+			release()
+		}
+	}
+}
+
+func newRate(bps int64) *rate.Limiter {
+	if bps <= 0 {
+		return rate.NewLimiter(rate.Inf, 64*1024)
+	}
+	burst := int(bps)
+	if burst < 1 {
+		burst = 1
+	}
+	if burst > 64*1024 {
+		burst = 64 * 1024
+	}
+	return rate.NewLimiter(rate.Limit(bps), burst)
+}
+
+func waitRate(ctx context.Context, limiter *rate.Limiter, n int) error {
+	if limiter == nil || n <= 0 {
+		return nil
+	}
+	if n > limiter.Burst() {
+		n = limiter.Burst()
+	}
+	return limiter.WaitN(ctx, n)
+}
+
+type limitedConn struct {
+	net.Conn
+	ctx       context.Context
+	uplink    *rate.Limiter
+	downlink  *rate.Limiter
+	release   func()
+	closeOnce sync.Once
+}
+
+type rejectedConn struct {
+	net.Conn
+}
+
+func (c *rejectedConn) Read([]byte) (int, error) {
+	return 0, errors.New("vpn-aio: connection rejected by limit")
+}
+
+func (c *rejectedConn) Write([]byte) (int, error) {
+	return 0, errors.New("vpn-aio: connection rejected by limit")
+}
+
+func (c *limitedConn) Read(p []byte) (int, error) {
+	if c.uplink != nil && len(p) > c.uplink.Burst() {
+		p = p[:c.uplink.Burst()]
+	}
+	if err := waitRate(c.ctx, c.uplink, len(p)); err != nil {
+		return 0, err
+	}
+	return c.Conn.Read(p)
+}
+
+func (c *limitedConn) Write(p []byte) (int, error) {
+	written := 0
+	for len(p) > 0 {
+		chunk := p
+		if c.downlink != nil && len(chunk) > c.downlink.Burst() {
+			chunk = chunk[:c.downlink.Burst()]
+		}
+		if err := waitRate(c.ctx, c.downlink, len(chunk)); err != nil {
+			return written, err
+		}
+		n, err := c.Conn.Write(chunk)
+		written += n
+		p = p[n:]
+		if err != nil {
+			return written, err
+		}
+		if n == 0 {
+			return written, io.ErrShortWrite
+		}
+	}
+	return written, nil
+}
+
+func (c *limitedConn) Close() error {
+	c.closeOnce.Do(c.release)
+	return c.Conn.Close()
+}
+
+type limitedPacketConn struct {
+	N.PacketConn
+	ctx       context.Context
+	uplink    *rate.Limiter
+	downlink  *rate.Limiter
+	release   func()
+	closeOnce sync.Once
+}
+
+type rejectedPacketConn struct {
+	N.PacketConn
+}
+
+func (c *rejectedPacketConn) ReadPacket(*buf.Buffer) (M.Socksaddr, error) {
+	return M.Socksaddr{}, errors.New("vpn-aio: packet connection rejected by limit")
+}
+
+func (c *rejectedPacketConn) WritePacket(*buf.Buffer, M.Socksaddr) error {
+	return errors.New("vpn-aio: packet connection rejected by limit")
+}
+
+func (c *limitedPacketConn) ReadPacket(buffer *buf.Buffer) (M.Socksaddr, error) {
+	destination, err := c.PacketConn.ReadPacket(buffer)
+	if err != nil {
+		return destination, err
+	}
+	if err := waitRate(c.ctx, c.uplink, buffer.Len()); err != nil {
+		return destination, err
+	}
+	return destination, nil
+}
+
+func (c *limitedPacketConn) WritePacket(buffer *buf.Buffer, destination M.Socksaddr) error {
+	if err := waitRate(c.ctx, c.downlink, buffer.Len()); err != nil {
+		return err
+	}
+	return c.PacketConn.WritePacket(buffer, destination)
+}
+
+func (c *limitedPacketConn) Close() error {
+	c.closeOnce.Do(c.release)
+	return c.PacketConn.Close()
+}
